smart-ats.example.com {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    @backendApi path /api/*
    reverse_proxy @backendApi 127.0.0.1:18080 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Port 443
    }

    @internalApi path /internal/api/*
    handle @internalApi {
        @notLocal not remote_ip 127.0.0.1/32 ::1
        respond @notLocal "forbidden" 403
        reverse_proxy 127.0.0.1:18080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Port 443
        }
    }

    @aiService path /ai-service/*
    handle @aiService {
        uri strip_prefix /ai-service
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Port 443
        }
    }

    reverse_proxy 127.0.0.1:5173 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Port 443
    }
}